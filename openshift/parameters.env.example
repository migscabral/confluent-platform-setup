export CFLT_REGISTRY=docker.io
# Registry address for the image-pull secret (use your internal registry's address when switching).
export CFLT_REGISTRY_SERVER=https://index.docker.io/v1/
# Credentials for the image-pull secret (Docker Hub: use a personal access token). Don't commit real values.
export CFLT_REGISTRY_USERNAME=REPLACE_ME
export CFLT_REGISTRY_PASSWORD=REPLACE_ME
export CFLT_REGISTRY_EMAIL=REPLACE_ME

# Wildcard apps domain used for every Route (find yours: oc get ingresses.config/cluster -o jsonpath='{.spec.domain}').
export CFLT_OCP_ROUTE_DOMAIN=confluent.testing
export CFLT_KAFKA_EXTERNAL_BOOTSTRAP=kafka.${CFLT_OCP_ROUTE_DOMAIN}:443

# Confluent Platform component versions.
export CFLT_CP_VERSION=8.3.1
export CFLT_INIT_VERSION=3.3.0
export CFLT_C3_VERSION=2.5.0

# Helm chart versions (the chart version differs from the CFK product version, 3.3.0).
export CFLT_CFK_CHART_VERSION=0.1718.10
export CFLT_CMF_CHART_VERSION=2.4.2
export CFLT_FKO_CHART_VERSION=1.150.3

# CMF Flink SQL needs the cp-flink-sql image; CFLT_FLINK_VERSION must match its Flink version.
export CFLT_FLINK_IMAGE=${CFLT_REGISTRY}/confluentinc/cp-flink-sql:1.19-cp10
export CFLT_FLINK_VERSION=v1_19